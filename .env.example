# ==========================================
# HOMI — Platform Configuration Example
# ==========================================

# 1. Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
DATABASE_URL=postgresql://akashlodhi@localhost:5432/homi
POSTGRES_USER=homi
POSTGRES_DB=homi
POSTGRES_PASSWORD=your_strong_password_here

# 2. Supabase Integration (Optional managed cloud services)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. Go Backend Service (Port 4000)
PORT=4000
APP_ENV=development
JWT_SECRET=homi-secret-jwt-key-32-chars-long-minimum-secure
WHATSAPP_GROUP_INVITE_URL=https://chat.whatsapp.com/ISoKOfnlJEe1MowRiGGlGb?s=cl&p=a&iam=2

# 4. Applications Networking
CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api
